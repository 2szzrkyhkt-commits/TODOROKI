{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TODOROKI common numeric response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "access",
    "generated_at",
    "partial",
    "items",
    "next_cursor",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project": {
      "enum": [
        "equity-jp",
        "equity-us",
        "statistics-jp",
        "statistics-us",
        "support",
        "slot",
        "learning",
        "content"
      ]
    },
    "access": {
      "enum": [
        "public",
        "owner",
        "access-protected"
      ]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "partial": {
      "type": "boolean"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "next_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project",
          "code",
          "retry_at"
        ],
        "properties": {
          "project": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "retry_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "checked_at"
      ],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "document_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "period",
        "value",
        "unit",
        "scale",
        "status",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "enum": [
            "JPY",
            "USD",
            "ratio",
            "percent",
            "count",
            "index"
          ]
        },
        "scale": {
          "enum": [
            1,
            1000,
            1000000,
            1000000000
          ]
        },
        "status": {
          "enum": [
            "verified",
            "calculated",
            "missing",
            "pending",
            "incompatible",
            "stale"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "formula_version": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "standard": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "verified",
                  "calculated"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              },
              "sources": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "missing"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "calculated"
              }
            }
          },
          "then": {
            "required": [
              "formula_version",
              "inputs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "unit": {
                "enum": [
                  "ratio",
                  "percent",
                  "count",
                  "index"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "scale": {
                "const": 1
              }
            }
          }
        }
      ]
    }
  }
}
