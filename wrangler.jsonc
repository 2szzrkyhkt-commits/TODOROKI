{
  "name": "todoroki",
  "main": "worker.js",
  "compatibility_date": "2026-10-08",
  "keep_vars": true,
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "todoroki-members",
      "database_id": "1c5c2222-a57e-4098-bbb3-878774c676d6"
    }
  ]
}
